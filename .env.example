PORT=4000

# Frontend API target. The Vite app defaults to http://localhost:4000.
VITE_API_URL=http://localhost:4000

# Restrict this in a deployed environment. '*' is used only for local development.
NEXTGUARD_ALLOWED_ORIGIN=http://localhost:5173

# Optional write authentication and role enforcement.
NEXTGUARD_API_KEY=
NEXTGUARD_RBAC=false
NEXTGUARD_RESPONSE_WEBHOOK=

# Optional file connectors. Files are read incrementally as JSONL/Zeek logs grow.
SURICATA_EVE_FILE=
ZEEK_CONN_FILE=
OPENVAS_JSON_FILE=
GREENBONE_JSON_FILE=
NEXTGUARD_CONNECTOR_INTERVAL_MS=5000

# Optional Splunk REST polling connector.
SPLUNK_URL=
SPLUNK_TOKEN=
SPLUNK_QUERY=search index=security earliest=-5m

# Optional vulnerability-intelligence feed URLs.
CISA_KEV_URL=
EPSS_URL=
CVE_FEED_URL=

# Optional Neo4j persistence.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
